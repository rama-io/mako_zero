<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/section_root"
    style="@style/VerticalList"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/section_header"
        style="@style/HorizontalList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/section_indicator"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_collapse_indicator" />

        <View style="@style/SeparatorListHorizontal" />

        <TextView
            android:id="@+id/section_label"
            style="@style/H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:id="@+id/section_content_separator"
        style="@style/SeparatorListVertical" />

    <LinearLayout
        android:id="@+id/section_content"
        style="@style/VerticalList"
        android:orientation="vertical" />
</LinearLayout>