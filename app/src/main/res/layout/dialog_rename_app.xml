<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Dialog_Root">

    <TextView
        style="@style/H2_center"
        android:text="@string/header_rename_app" />

    <View style="@style/SeparatorListVertical" />

    <LinearLayout style="@style/HorizontalList_BG2">

        <EditText
            android:id="@+id/edit_text"
            style="@style/EditText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusableInTouchMode="true" />

        <FrameLayout
            android:id="@+id/yes_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12sp">

            <ImageView
                style="@style/Icon24"
                android:src="@drawable/px_disk" />
        </FrameLayout>
    </LinearLayout>

    <View style="@style/SeparatorListVertical" />

    <Button
        android:id="@+id/reset_button"
        style="@style/BTN_danger"
        android:text="@string/btn_reset" />

    <include layout="@layout/dialog_cancel_button" />
</LinearLayout>