<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Mako" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/base</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <style name="Dialog_Root" parent="VerticalList">
        <item name="android:background">@color/base</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">16sp</item>
    </style>

    <style name="BlockFlow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="HorizontalList" parent="BlockFlow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="HorizontalList_BG2" parent="HorizontalList">
        <item name="android:background">@color/surface_0</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="VerticalList" parent="BlockFlow">
        <item name="android:orientation">vertical</item>
    </style>

    <style name="VerticalList_BG2" parent="VerticalList">
        <item name="android:background">@color/surface_0</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="H1" parent="BlockFlow">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/h1</item>
    </style>

    <style name="H2" parent="BlockFlow">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/h2</item>
    </style>

    <style name="H2_center" parent="H2">
        <item name="android:gravity">center</item>
    </style>

    <style name="H3" parent="BlockFlow">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/h3</item>
    </style>

    <style name="H3_Center" parent="H3">
        <item name="android:gravity">center</item>
    </style>

    <style name="Disclaimer" parent="BlockFlow">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/h3</item>
    </style>

    <style name="Text" parent="BlockFlow">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text</item>
    </style>

    <style name="Text_Center" parent="Text">
        <item name="android:gravity">center</item>
    </style>

    <style name="BTN" parent="BlockFlow">
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/base</item>
        <item name="android:textSize">@dimen/text</item>
        <item name="android:background">@color/accent</item>
    </style>
    <style name="BTN_danger" parent="BTN">
        <item name="android:background">@color/error</item>
    </style>

    <style name="Checkbox" parent="BlockFlow" />

    <style name="EditText" parent="BlockFlow">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/text</item>
        <item name="android:background">@color/base</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Icon24">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:tint">@color/text</item>
    </style>

    <style name="Icon32">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="Separator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/disabled</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="SeparatorListHorizontal">
        <item name="android:layout_width">@dimen/space_between_elements</item>
        <item name="android:layout_height">@dimen/space_between_elements</item>
    </style>

    <style name="SeparatorListHorizontalSmall">
        <item name="android:layout_width">@dimen/space_between_elements_small</item>
        <item name="android:layout_height">@dimen/space_between_elements_small</item>
    </style>

    <style name="SeparatorListVertical">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/space_between_elements</item>
    </style>
</resources>
